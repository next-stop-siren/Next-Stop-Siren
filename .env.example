# Local development only. Replace these example passwords for your own machine.
DEV_DB_USER=b71_dev
DEV_DB_PASSWORD=local_dev_only_change_me
DEV_DB_NAME=b71_dev
TEST_DB_USER=b71_test
TEST_DB_PASSWORD=local_test_only_change_me
TEST_DB_NAME=b71_test
DATABASE_URL=postgresql://b71_dev:local_dev_only_change_me@127.0.0.1:55432/b71_dev

AUTH_ENV=development
# Generate each key independently; see docs/01-start/onboarding.md.
# Keep real keys in .env only.
AUTH_ACCESS_KEY=
AUTH_REFRESH_KEY=
AUTH_REFRESH_DIGEST_KEY=
AUTH_CSRF_KEY=
AUTH_ACCESS_KID=local-access-v1
AUTH_REFRESH_KID=local-refresh-v1
AUTH_JWT_ISSUER=next-stop-siren
AUTH_JWT_AUDIENCE=next-stop-siren-api
AUTH_API_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false

# Google OIDC 설정: Google 로그인에 필요하며 로컬 비밀번호 인증에는 필요하지 않다.
# 실제 자격 증명은 .env에만 보관한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# 트랜잭션 쿠키 암호화에 사용할 독립적인 32바이트 키를 Base64로 인코딩해 넣는다.
GOOGLE_TRANSACTION_KEY=
