# Local development only. Replace these example passwords for your own machine.
DEV_DB_USER=b71_dev
DEV_DB_PASSWORD=local_dev_only_change_me
DEV_DB_NAME=b71_dev
TEST_DB_USER=b71_test
TEST_DB_PASSWORD=local_test_only_change_me
TEST_DB_NAME=b71_test
DATABASE_URL=postgresql://b71_dev:local_dev_only_change_me@127.0.0.1:55432/b71_dev

AUTH_ENV=development
# Generate each key independently; see docs/01-start/onboarding.md.
# Keep real keys in .env only.
AUTH_ACCESS_KEY=
AUTH_REFRESH_KEY=
AUTH_REFRESH_DIGEST_KEY=
AUTH_CSRF_KEY=
AUTH_ACCESS_KID=local-access-v1
AUTH_REFRESH_KID=local-refresh-v1
AUTH_JWT_ISSUER=next-stop-siren
AUTH_JWT_AUDIENCE=next-stop-siren-api
AUTH_API_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false

# 가입 접수 제한: 서버 전체 최근 600초 동안 최대 10건.
# 네 값은 양의 정수만 허용하며, 생략하면 아래 기본값을 사용한다.
# 변경 후 백엔드 재시작 필요. 단일 worker·복제본 전제이며 재시작 시 카운터가 초기화된다.
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=600
# 가입 해시·저장·쿠키 설정 또는 실패 보상 종료까지 유지할 동시 처리 상한.
AUTH_REGISTER_MAX_CONCURRENT=1
# 처리 자리 부족 시 503 응답의 Retry-After로 안내할 초. 대기열·자동 재시도는 없다.
AUTH_REGISTER_BUSY_RETRY_SECONDS=5

# Google OIDC 설정: Google 로그인에 필요하며 로컬 비밀번호 인증에는 필요하지 않다.
# 실제 자격 증명은 .env에만 보관한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Optional frontend destination after success; must match an allowed Origin and API scheme/host.
# Remove this setting to retain the legacy relative redirect. An explicitly empty value is invalid.
GOOGLE_FRONTEND_ORIGIN=http://127.0.0.1:5173
# 트랜잭션 쿠키 암호화에 사용할 독립적인 32바이트 키를 Base64로 인코딩해 넣는다.
GOOGLE_TRANSACTION_KEY=
# S11 Codyssey GPT, isolated smoke test only; see docs/04-reference/ai.md.
# Put your own key in .env only; never share it or pass it to the frontend.
# The URL and model are the approved, fixed values; others are refused.
CODYSSEY_API_KEY=
CODYSSEY_BASE_URL=https://copa.codyssey.kr/v1
CODYSSEY_MODEL=gpt-5.5
