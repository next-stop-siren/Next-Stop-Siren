{
  "name": "b7-1-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format src e2e vite.config.ts playwright.config.ts",
    "lint": "biome lint src e2e vite.config.ts playwright.config.ts",
    "build": "tsc --noEmit && vite build",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist', 'node_modules/.vite']) fs.rmSync(path, { recursive: true, force: true })\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
