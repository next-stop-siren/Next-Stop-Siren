{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {"Federated": "arn:aws:iam::__REQUIRED_ACCOUNT_ID__:oidc-provider/token.actions.githubusercontent.com"},
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Condition": {"StringEquals": {
      "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
      "token.actions.githubusercontent.com:sub": "__REQUIRED_EXACT_OBSERVED_SUBJECT_FOR_THIS_REPOSITORY_AND_PILOT_ENVIRONMENT__"
    }}
  }]
}
