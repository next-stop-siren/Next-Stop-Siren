# Secret-free, intentionally incomplete. Never use placeholder passwords/keys.
# Owner keeps originals/recovery in an encrypted PC vault. Do not commit filled copies.
POSTGRES_USER=next_stop_siren
POSTGRES_DB=next_stop_siren
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_ENV=production
AUTH_ACCESS_KEY=
AUTH_REFRESH_KEY=
AUTH_REFRESH_DIGEST_KEY=
AUTH_CSRF_KEY=
AUTH_ACCESS_KID=pilot-access-v1
AUTH_REFRESH_KID=pilot-refresh-v1
AUTH_JWT_ISSUER=next-stop-siren
AUTH_JWT_AUDIENCE=next-stop-siren-api
AUTH_API_ORIGIN=https://next-stop-siren.duckdns.org
AUTH_ALLOWED_ORIGINS=https://next-stop-siren.duckdns.org
AUTH_COOKIE_SECURE=true
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_REGISTER_MAX_CONCURRENT=1
AUTH_REGISTER_BUSY_RETRY_SECONDS=5
CHAT_WORKER=on
