# Secret-free, intentionally incomplete. Never use placeholder passwords/keys.
# Owner keeps originals/recovery in an encrypted PC vault. Do not commit filled copies.
POSTGRES_USER=next_stop_siren
POSTGRES_DB=next_stop_siren
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_ENV=production
AUTH_ACCESS_KEY=
AUTH_REFRESH_KEY=
AUTH_REFRESH_DIGEST_KEY=
AUTH_CSRF_KEY=
AUTH_ACCESS_KID=pilot-access-v1
AUTH_REFRESH_KID=pilot-refresh-v1
AUTH_JWT_ISSUER=next-stop-siren
AUTH_JWT_AUDIENCE=next-stop-siren-api
AUTH_API_ORIGIN=https://next-stop-siren.duckdns.org
AUTH_ALLOWED_ORIGINS=https://next-stop-siren.duckdns.org
AUTH_COOKIE_SECURE=true
# 필수: backend가 신뢰할 실제 Nginx 연결 IP 또는 Owner가 승인한 가장 좁은 전용 CIDR.
# 쉼표 목록 허용. *, /0, 호스트 이름, 포트/URL, 빈 항목, 잘못된 IP/CIDR은 거부한다.
# 실제 값 확정 뒤 채운다. 이 빈 예시는 preflight/startup에서 의도적으로 실패한다.
# 서버 runtime 전용이며 프런트 번들에 넣지 않는다. 변경 뒤 backend 재시작 필요.
FORWARDED_ALLOW_IPS=
# UVICORN_FORWARDED_ALLOW_IPS는 생략한다. 함께 지정하면 위 값과 문자열이 정확히 같아야 한다.
# 다른 값(빈 값 포함)이면 시작을 차단해 Uvicorn이 검사한 신뢰 목록을 덮어쓰지 못하게 한다.
AUTH_REGISTER_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_REGISTER_MAX_CONCURRENT=1
AUTH_REGISTER_BUSY_RETRY_SECONDS=5
CHAT_WORKER=on
# Optional Google: omit all three credentials for local password auth.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TRANSACTION_KEY=
# GOOGLE_REDIRECT_URI=https://next-stop-siren.duckdns.org/api/auth/google/callback
# GOOGLE_FRONTEND_ORIGIN=https://next-stop-siren.duckdns.org
